# MASA backend configuration (all optional; defaults shown below).
# Copy to .env for local development, or set via environment in docker-compose.

# SQLite database location (sqlite:/// + relative or absolute path)
MASA_DATABASE_URL=sqlite:///./data/masa.db

# Redis used by RQ (queue + worker). In Docker Compose this is redis://redis:6379/0
MASA_REDIS_URL=redis://localhost:6379/0

# Working directory for uploads / decompiled output / chroma (added in later milestones)
MASA_DATA_DIR=./data

# Logging level: DEBUG | INFO | WARNING | ERROR
MASA_LOG_LEVEL=INFO

# ---- M3 model backends ----
# Local LLM servers on the host. Docker Compose overrides these with
# host.docker.internal URLs so the container reaches the host.
MASA_OLLAMA_BASE_URL=http://localhost:11434
MASA_LM_STUDIO_BASE_URL=http://localhost:1234/v1

# BYOK provider keys (optional; also enterable at runtime via the Settings
# modal / API — stored in model_backends.json with 0600 perms).
# MASA_OPENAI_API_KEY=
# MASA_ANTHROPIC_API_KEY=
# MASA_DEEPSEEK_API_KEY=
# MASA_OPENROUTER_API_KEY=

# Default chat model per backend (blank = no hard default; the user picks one
# from the models the backend actually serves).
# MASA_DEFAULT_CHAT_MODEL=
