[TEMPLATE]
# MobARK backend configuration (all optional; defaults shown below).
# Copy to .env for local development, or set via environment in docker-compose.

# SQLite database location (sqlite:/// + relative or absolute path)
MOBARK_DATABASE_URL=sqlite:///./data/mobark.db

# Redis used by RQ (queue + worker). In Docker Compose this is redis://redis:6379/0
MOBARK_REDIS_URL=redis://localhost:6379/0

# Working directory for uploads / decompiled output / chroma (added in later milestones)
MOBARK_DATA_DIR=./data

# Logging level: DEBUG | INFO | WARNING | ERROR
MOBARK_LOG_LEVEL=INFO

# ---- M3 model backends ----
# Local LLM servers on the host. Docker Compose overrides these with
# host.docker.internal URLs so the container reaches the host.
MOBARK_OLLAMA_BASE_URL=http://localhost:11434
MOBARK_LM_STUDIO_BASE_URL=http://localhost:1234/v1

# BYOK provider keys (optional; also enterable at runtime via the Settings
# modal / API — stored in model_backends.json with 0600 perms).
# MOBARK_OPENAI_API_KEY=
# MOBARK_ANTHROPIC_API_KEY=
# MOBARK_DEEPSEEK_API_KEY=
# MOBARK_OPENROUTER_API_KEY=
# MOBARK_GEMINI_API_KEY=

# Default chat model per backend (blank = no hard default; the user picks one
# from the models the backend actually serves).
# MOBARK_DEFAULT_CHAT_MODEL=

# ---- M9.1 auth ----
# Auth ON by default: a fresh install lands on the register/login screen;
# the first registered user is the instance admin. Set MOBARK_AUTH_ENABLED=0
# to restore the fully-open pre-M9.1 behavior (dev/CI parity mode).
MOBARK_AUTH_ENABLED=1
# Session lifetime in days (sliding - refreshed on use).
MOBARK_SESSION_DAYS=7
# Set MOBARK_COOKIE_SECURE=1 when serving over TLS (the session cookie then
# gets the Secure attribute and is never sent over plain HTTP).
MOBARK_COOKIE_SECURE=0

# ---- M9.1 OAuth (GitHub + Google) ----
# A provider is configured only when BOTH its client id and secret are set;
# the login page then renders that provider's button. Register the app at
# https://github.com/settings/developers and
# https://console.cloud.google.com/apis/credentials with the redirect URI
# {MOBARK_PUBLIC_BASE_URL}/api/v1/auth/oauth/{github|google}/callback.
# MOBARK_GITHUB_CLIENT_ID=
# MOBARK_GITHUB_CLIENT_SECRET=
# MOBARK_GOOGLE_CLIENT_ID=
# MOBARK_GOOGLE_CLIENT_SECRET=
# The public origin of THIS install - OAuth redirect_uris are derived from
# it (never from the request). Local dev default:
MOBARK_PUBLIC_BASE_URL=http://localhost:8000

# ---- docker compose (not read by the backend itself) ----
# Which suwasto/mobark image tag the compose stack runs (release installs:
# `docker compose pull` gets this exact tag; the version portion is also
# baked into the image as MOBARK_VERSION and shown by /api/v1/health).
# Default 0.2.0; set to a newer release tag to upgrade.
# MOBARK_IMAGE_TAG=0.2.0
# Version baked into locally-built images (docker compose up --build);
# the release workflow overrides this from the git tag.
# MOBARK_VERSION=0.2.0
