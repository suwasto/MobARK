# MASA backend configuration (all optional; defaults shown below).
# Copy to .env for local development, or set via environment in docker-compose.

# SQLite database location (sqlite:/// + relative or absolute path)
MASA_DATABASE_URL=sqlite:///./data/masa.db

# Redis used by RQ (queue + worker). In Docker Compose this is redis://redis:6379/0
MASA_REDIS_URL=redis://localhost:6379/0

# Working directory for uploads / decompiled output / chroma (added in later milestones)
MASA_DATA_DIR=./data

# Logging level: DEBUG | INFO | WARNING | ERROR
MASA_LOG_LEVEL=INFO

# ---- M3 model backends ----
# Local LLM servers on the host. Docker Compose overrides these with
# host.docker.internal URLs so the container reaches the host.
MASA_OLLAMA_BASE_URL=http://localhost:11434
MASA_LM_STUDIO_BASE_URL=http://localhost:1234/v1

# BYOK provider keys (optional; also enterable at runtime via the Settings
# modal / API — stored in model_backends.json with 0600 perms).
# MASA_OPENAI_API_KEY=
# MASA_ANTHROPIC_API_KEY=
# MASA_DEEPSEEK_API_KEY=
# MASA_OPENROUTER_API_KEY=

# Default chat model per backend (blank = no hard default; the user picks one
# from the models the backend actually serves).
# MASA_DEFAULT_CHAT_MODEL=

# ---- M9.1 auth ----
# Auth ON by default: a fresh install lands on the register/login screen;
# the first registered user is the instance admin. Set MASA_AUTH_ENABLED=0
# to restore the fully-open pre-M9.1 behavior (dev/CI parity mode).
MASA_AUTH_ENABLED=1
# Session lifetime in days (sliding - refreshed on use).
MASA_SESSION_DAYS=7
# Set MASA_COOKIE_SECURE=1 when serving over TLS (the session cookie then
# gets the Secure attribute and is never sent over plain HTTP).
MASA_COOKIE_SECURE=0

# ---- M9.1 OAuth (GitHub + Google) ----
# A provider is configured only when BOTH its client id and secret are set;
# the login page then renders that provider's button. Register the app at
# https://github.com/settings/developers and
# https://console.cloud.google.com/apis/credentials with the redirect URI
# {MASA_PUBLIC_BASE_URL}/api/v1/auth/oauth/{github|google}/callback.
# MASA_GITHUB_CLIENT_ID=
# MASA_GITHUB_CLIENT_SECRET=
# MASA_GOOGLE_CLIENT_ID=
# MASA_GOOGLE_CLIENT_SECRET=
# The public origin of THIS install - OAuth redirect_uris are derived from
# it (never from the request). Local dev default:
MASA_PUBLIC_BASE_URL=http://localhost:8000
